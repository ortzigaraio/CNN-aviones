# Copiar a .env (que no va a git) y ajustar si hace falta. Aquí nunca van valores secretos.

# Retraso mínimo, en días, para aceptar una fecha (análisis retrospectivo).
# Solo se puede subir: cualquier valor menor que 30 se trata como 30.
AVION_OSINT_RETRASO_DIAS=30

# Dónde guarda MLflow el registro de experimentos (carpeta local, ignorada por git).
MLFLOW_TRACKING_URI=mlruns
